{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RDEToolKit agent diagnostics envelope version 1",
  "type": "object",
  "required": ["schema_version", "command", "status", "diagnostics"],
  "properties": {
    "schema_version": {"const": "1"},
    "command": {"enum": ["nodes lint", "doctor", "report diagnose"]},
    "status": {"enum": ["passed", "warning", "failed"]},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "name", "message", "remediation", "subject"],
        "properties": {
          "code": {"type": ["integer", "null"]},
          "severity": {"enum": ["info", "warning", "error"]},
          "name": {"type": "string"},
          "message": {"type": "string"},
          "remediation": {"type": "string"},
          "subject": {"type": "string"},
          "location": {
            "type": "object",
            "properties": {
              "path": {"type": "string"},
              "pointer": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
