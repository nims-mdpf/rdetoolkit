from collections.abc import Sequence
from dataclasses import dataclass
from typing import Any, Final
from rdetoolkit.graph.readers.base import FormatCandidate
from rdetoolkit.runner.input_snapshot import InputGroup

TABULAR_SUFFIXES: Final[tuple[str, ...]]
GRAPH_CHECKS: Final[tuple[str, ...]]
GRAPH_NOT_CHECKED: Final[tuple[str, ...]]

@dataclass(frozen=True, slots=True)
class GraphFilePreview:
    name: str
    status: str
    reason: str
    reader: str | None = ...
    candidates: tuple[FormatCandidate, ...] = ...
    encoding: str | None = ...
    delimiter: str | None = ...
    column_count: int | None = ...
    data_rows: int | None = ...
    sampled_rows: int = ...
    truncated: bool = ...
    def to_dict(self) -> dict[str, Any]: ...

@dataclass(frozen=True, slots=True)
class GraphTilePreview:
    index: int
    files: tuple[GraphFilePreview, ...]
    def to_dict(self) -> dict[str, Any]: ...

@dataclass(frozen=True, slots=True)
class GraphPreview:
    status: str
    reason: str
    tiles: tuple[GraphTilePreview, ...] = ...
    def to_dict(self) -> dict[str, Any]: ...

def preview_graph_inputs(groups: Sequence[InputGroup]) -> GraphPreview: ...
