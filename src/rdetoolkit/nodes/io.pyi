def read_excel(path: Path, *, sheet_name: None, header: int | list[int] | None = 0, skiprows: int | list[int] | None = None, nrows: int | None = None, usecols: str | list[int] | list[str] | None = None, **pandas_kwargs: object) -> dict[str, pd.DataFrame]: ...
@overload
def read_excel(path: Path, *, sheet_name: list[str], header: int | list[int] | None = 0, skiprows: int | list[int] | None = None, nrows: int | None = None, usecols: str | list[int] | list[str] | None = None, **pandas_kwargs: object) -> dict[str, pd.DataFrame]: ...
@overload
def read_excel(path: Path, *, sheet_name: list[int], header: int | list[int] | None = 0, skiprows: int | list[int] | None = None, nrows: int | None = None, usecols: str | list[int] | list[str] | None = None, **pandas_kwargs: object) -> dict[int, pd.DataFrame]: ...
