from pathlib import Path
from typing import Any

import pandas as pd

def read_text(path: Path) -> str: ...
def read_csv_with_header(path: Path) -> pd.DataFrame: ...
def read_key_values(path: Path, *, key: str = "key", value: str = "value", encoding: str | None = None, missing_ok: bool = False) -> dict[str, str]: ...
def read_excel(path: Path, *, sheet_name: str | int = 0, header: int | list[int] | None = 0, skiprows: int | list[int] | None = None, nrows: int | None = None, usecols: str | list[int] | list[str] | None = None, **pandas_kwargs: object) -> pd.DataFrame: ...
def read_excel_fills(path: Path, *, column: str | int, sheet_name: str | int = 0, header: int | None = 0, skiprows: int = 0, nrows: int | None = None) -> list[str | None]: ...
def read_json(path: Path) -> Any: ...
def unzip_inputs(src_zip: Path, dst_dir: Path, *, include_dirs: bool = False) -> list[Path]: ...
