def read_excel(path: Path, *, sheet_name: list[str | int], header: int | list[int] | None = 0, skiprows: int | list[int] | None = None, nrows: int | None = None, usecols: str | list[int] | list[str] | None = None, **pandas_kwargs: object) -> dict[str | int, pd.DataFrame]: ...
def list_excel_sheets(path: Path) -> list[str]: ...
def read_excel_fills(path: Path, *, column: str | int, sheet_name: str | int = 0, header: int | None = 0, skiprows: int = 0, nrows: int | None = None) -> list[str | None]: ...
