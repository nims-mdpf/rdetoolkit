{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nims-mdpf.github.io/rdetoolkit/schemas/registration-explain-v1.json",
  "title": "Registration explanation version 1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "status": {
          "const": "success"
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "tile_count": {
          "type": "integer",
          "minimum": 0
        },
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tile"
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "config_source": {
          "type": "string"
        },
        "iteration_policy": {
          "type": "string"
        },
        "deterministic_order": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        },
        "magic_preview": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "not_checked": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tiles": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/magic_tile"
              }
            }
          },
          "required": [
            "status",
            "reason"
          ]
        },
        "graph_preview": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "not_checked": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tiles": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/graph_tile"
              }
            }
          },
          "required": [
            "status",
            "reason"
          ]
        }
      },
      "required": [
        "schema_version",
        "status",
        "decision",
        "tile_count",
        "tiles",
        "stages",
        "config_source",
        "iteration_policy",
        "deterministic_order",
        "warnings",
        "preparation",
        "magic_preview",
        "graph_preview"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "status": {
          "const": "failed"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "detail": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "name",
            "message"
          ]
        }
      },
      "required": [
        "schema_version",
        "status",
        "error"
      ]
    }
  ],
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "thumbnail",
            "structured",
            "magic",
            "description"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "enabled",
        "reason",
        "side_effects"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "configured_mode": {
          "anyOf": [
            {
              "enum": [
                "invoice",
                "multidatatile",
                "smarttable",
                "excelinvoice",
                "rdeformat"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "chosen_mode": {
          "enum": [
            "invoice",
            "multidatatile",
            "smarttable",
            "excelinvoice",
            "rdeformat"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "enum": [
              "invoice",
              "multidatatile",
              "smarttable",
              "excelinvoice",
              "rdeformat"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "invoice",
                  "multidatatile",
                  "smarttable",
                  "excelinvoice",
                  "rdeformat"
                ]
              },
              "filename": {
                "type": "string"
              },
              "indicator": {
                "type": "string"
              }
            },
            "required": [
              "mode",
              "filename",
              "indicator"
            ]
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ambiguous": {
          "type": "boolean"
        },
        "warning_codes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "schema_version",
        "configured_mode",
        "chosen_mode",
        "candidates",
        "evidence",
        "reason_codes",
        "ambiguous",
        "warning_codes"
      ]
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "input_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_row": {
          "type": [
            "integer",
            "null"
          ]
        },
        "invoice_origin": {
          "type": "string"
        },
        "output_paths": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "invokes_flow": {
          "type": "boolean"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          }
        }
      },
      "required": [
        "index",
        "input_names",
        "source_row",
        "invoice_origin",
        "output_paths",
        "invokes_flow",
        "stages"
      ]
    },
    "magic_tile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/magic_diagnostic"
          }
        }
      },
      "required": [
        "index",
        "status",
        "reason",
        "diagnostics"
      ]
    },
    "magic_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "destination": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "offset": {
          "type": "integer"
        },
        "source_scope": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "iteration_index": {
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        }
      },
      "required": [
        "destination",
        "expression",
        "offset",
        "source_scope",
        "source_path",
        "iteration_index",
        "status",
        "reason",
        "code",
        "message",
        "remediation"
      ]
    },
    "graph_tile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graph_file"
          }
        }
      },
      "required": [
        "index",
        "files"
      ]
    },
    "graph_file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "detected",
            "ambiguous",
            "unreadable",
            "skipped"
          ]
        },
        "reason": {
          "type": "string"
        },
        "reader": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reader_id": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "reader_id",
              "confidence",
              "evidence"
            ]
          }
        },
        "encoding": {
          "type": [
            "string",
            "null"
          ]
        },
        "delimiter": {
          "type": [
            "string",
            "null"
          ]
        },
        "column_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "data_rows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sampled_rows": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "status",
        "reason",
        "reader",
        "candidates",
        "encoding",
        "delimiter",
        "column_count",
        "data_rows",
        "sampled_rows",
        "truncated"
      ]
    }
  }
}
